# Recherche YouTube : Worker Cloudflare ou serveur Netlify uniquement, jamais VITE_ ni dans Git.
YOUTUBE_API_KEY=

# Comptes et synchronisation : réglages publics du projet Supabase.
# Le Worker expose uniquement ces deux valeurs via GET /api/config.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Ancien format public accepté si SUPABASE_PUBLISHABLE_KEY est vide :
SUPABASE_ANON_KEY=

# Facultatif : compiler ces mêmes réglages PUBLICS dans le site / le .exe.
# Sinon Windows découvre la configuration sur https://thrum.uno/api/config.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NE JAMAIS renseigner service_role ou sb_secret_ dans ces variables.
# Les jetons Netlify/GitHub et secrets Supabase ne vont pas dans ce fichier.
